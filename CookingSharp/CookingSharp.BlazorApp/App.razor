@using CookingSharp.BlazorApp.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Routing



<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <div class="unauthorized-container">
                            <div class="unauthorized-card">
                                <span class="icon">🔒</span>
                                <h1>Acceso Denegado</h1>
                                <p>No tienes permisos para acceder a esta página.</p>
                                <a href="/" class="btn-back">Volver al inicio</a>
                            </div>
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>No encontrado</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="not-found-container">
                    <div class="not-found-card">
                        <span class="icon">🔍</span>
                        <h1>404</h1>
                        <p>La página que buscas no existe.</p>
                        <a href="/" class="btn-back">Volver al inicio</a>
                    </div>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

<style>
    .unauthorized-container, .not-found-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f5f5f5;
        padding: 20px;
    }

    .unauthorized-card, .not-found-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        padding: 60px 40px;
        text-align: center;
        max-width: 500px;
    }

    .unauthorized-card .icon, .not-found-card .icon {
        font-size: 80px;
        display: block;
        margin-bottom: 20px;
    }

    .unauthorized-card h1, .not-found-card h1 {
        font-size: 32px;
        color: #333;
        margin: 0 0 15px 0;
    }

    .unauthorized-card p, .not-found-card p {
        color: #666;
        font-size: 16px;
        margin: 0 0 30px 0;
    }

    .btn-back {
        display: inline-block;
        padding: 12px 30px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-back:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
    }
</style>