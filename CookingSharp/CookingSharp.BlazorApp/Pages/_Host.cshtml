@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace CookingSharp.BlazorApp.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>CookingSharp - Recetas</title>
    <link href="css/site.css" rel="stylesheet" />
    <link href="CookingSharp.BlazorApp.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Ha ocurrido un error. Esta aplicación podría no responder hasta que se recargue.
        </environment>
        <environment include="Development">
            Ha ocurrido una excepción no controlada. Consulta los registros del navegador para obtener más detalles.
        </environment>
        <a href="" class="reload">Recargar</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>