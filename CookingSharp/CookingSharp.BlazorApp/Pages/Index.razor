@page "/"
@layout EmptyLayout
@using CookingSharp.BlazorApp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CookingSharp.BlazorApp.Shared

@* @attribute [Authorize]
@inject AuthService AuthService *@

<div class="home-container">
    <div class="welcome-section">
        <h1>¡Bienvenido a CookingSharp! 👨‍🍳</h1>
        <p class="subtitle">Tu plataforma de recetas favorita</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-icon">📖</span>
            <div class="stat-content">
                <h3>@totalRecipes</h3>
                <p>Recetas Disponibles</p>
            </div>
        </div>

        <div class="stat-card">
            <span class="stat-icon">📂</span>
            <div class="stat-content">
                <h3>@totalCategories</h3>
                <p>Categorías</p>
            </div>
        </div>

        <AuthorizeView Roles="Cocinero">
            <div class="stat-card">
                <span class="stat-icon">⭐</span>
                <div class="stat-content">
                    <h3>@myRecipes</h3>
                    <p>Mis Recetas</p>
                </div>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Aprendiz">
            <div class="stat-card">
                <span class="stat-icon">✉️</span>
                <div class="stat-content">
                    <h3>@myAppeals</h3>
                    <p>Mis Apelaciones</p>
                </div>
            </div>
        </AuthorizeView>
    </div>

    <div class="quick-actions">
        <h2>Acciones Rápidas</h2>
        <div class="actions-grid">
            <a href="/recipes" class="action-card">
                <span class="action-icon">🔍</span>
                <h3>Explorar Recetas</h3>
                <p>Descubre nuevas recetas deliciosas</p>
            </a>

            <AuthorizeView Roles="Cocinero">
                <a href="/recipes/create" class="action-card">
                    <span class="action-icon">➕</span>
                    <h3>Crear Receta</h3>
                    <p>Comparte tu receta con la comunidad</p>
                </a>
            </AuthorizeView>

            <a href="/categories" class="action-card">
                <span class="action-icon">📂</span>
                <h3>Ver Categorías</h3>
                <p>Explora recetas por categoría</p>
            </a>

            <a href="/profile" class="action-card">
                <span class="action-icon">👤</span>
                <h3>Mi Perfil</h3>
                <p>Gestiona tu información personal</p>
            </a>
        </div>
    </div>
</div>

<style>
    .home-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .welcome-section {
        text-align: center;
        margin-bottom: 40px;
        padding: 40px 20px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .welcome-section h1 {
        font-size: 36px;
        color: #333;
        margin: 0 0 10px 0;
        font-weight: 700;
    }

    .subtitle {
        font-size: 18px;
        color: #666;
        margin: 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }

    .stat-icon {
        font-size: 48px;
    }

    .stat-content h3 {
        font-size: 32px;
        color: #667eea;
        margin: 0 0 5px 0;
        font-weight: 700;
    }

    .stat-content p {
        font-size: 14px;
        color: #666;
        margin: 0;
    }

    .quick-actions h2 {
        font-size: 28px;
        color: #333;
        margin: 0 0 25px 0;
        font-weight: 700;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .action-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        text-decoration: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

    .action-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(102, 126, 234, 0.2);
        border-color: #667eea;
    }

    .action-icon {
        font-size: 48px;
        display: block;
        margin-bottom: 15px;
    }

    .action-card h3 {
        font-size: 20px;
        color: #333;
        margin: 0 0 10px 0;
        font-weight: 600;
    }

    .action-card p {
        font-size: 14px;
        color: #666;
        margin: 0;
        line-height: 1.5;
    }

        .stats-grid, .actions-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private int totalRecipes = 0;
    private int totalCategories = 0;
    private int myRecipes = 0;
    private int myAppeals = 0;

    protected override async Task OnInitializedAsync()
    {
        // Aquí cargarías los datos reales desde tu API
        // Por ahora usamos datos de ejemplo
        totalRecipes = 150;
        totalCategories = 12;
        myRecipes = 5;
        myAppeals = 2;
    }
}