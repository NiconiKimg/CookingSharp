@using WebApp.Auth
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using WebApp.DTOs
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient Http
@inject WebApp.Services.ILocalStorageService LocalStorage

<MudAppBar Elevation="1">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="OnDrawerToggle" />
    <MudText Typo="Typo.h6" Class="ml-4">Cooking#</MudText>
    <MudSpacer />
    
    <AuthorizeView>
        <Authorized>
            @{
                var roleClaim = @context.User.FindFirst(ClaimTypes.Role);
                var userRole = roleClaim?.Value ?? "Usuario";
            }
            <MudText Typo="Typo.body1">Hola, @userRole</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" Class="ml-2" />
        </Authorized>
        <NotAuthorized>
            <MudButton Href="login" Color="Color.Inherit">Login</MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>

@code {
    [Parameter]
    public EventCallback OnDrawerToggle { get; set; }

    private string? _displayName;

    protected override async Task OnInitializedAsync()
    {
        await LoadDisplayNameAsync();

        AuthenticationStateProvider.AuthenticationStateChanged += async (Task<AuthenticationState> authStateTask) =>
        {
            try
            {
                var _ = await authStateTask;
            }
            catch
            {
            }

            await InvokeAsync(async () =>
            {
                await LoadDisplayNameAsync();
                StateHasChanged();
            });
        };
    }

    private async Task LoadDisplayNameAsync()
    {
        _displayName = null;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated != true)
                return;

            var token = await LocalStorage.GetItemAsync<string>("authToken");
            if (!string.IsNullOrWhiteSpace(token) && Http.DefaultRequestHeaders.Authorization == null)
            {
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            }

            var idClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(idClaim) && int.TryParse(idClaim, out var id))
            {
                try
                {
                    var dto = await Http.GetFromJsonAsync<UserResponseDTO>($"api/users/{id}");
                    Console.WriteLine($"TopAppBar: user dto = {System.Text.Json.JsonSerializer.Serialize(dto)}");
                    if (dto != null)
                    {
                        var full = $"{dto.Name} {dto.Surname}".Trim();
                        if (!string.IsNullOrWhiteSpace(full))
                        {
                            _displayName = full;
                            return;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"TopAppBar: error fetching user {ex.Message}");
                }
            }

            _displayName = user.FindFirst(ClaimTypes.Name)?.Value
                           ?? user.FindFirst(ClaimTypes.Email)?.Value
                           ?? user.Identity?.Name;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"TopAppBar: LoadDisplayNameAsync fallo: {ex.Message}");
        }
    }

    private async Task Logout()
    {
        var customAuthStateProvider = (CustomAuthStateProvider)AuthenticationStateProvider;
        await customAuthStateProvider.MarkUserAsLoggedOut();
        NavigationManager.NavigateTo("/");
    }
}