@using WebApp.DTOs

<MudCard Elevation="3" Class="mud-height-full">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Menu.Name</MudText>
            <MudText Typo="Typo.body2">por @Menu.AuthorName</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2">@Menu.Description</MudText>
    </MudCardContent>
    <MudCardActions Class="d-flex justify-space-between">

        <MudChip T="string" Icon="@Icons.Material.Filled.Restaurant" Color="Color.Primary">@Menu.RecipeCount Recetas</MudChip>
        
        <MudChip T="string" Icon="@Icons.Material.Filled.Star" Color="Color.Warning">@Menu.AverageRating.ToString("F1")</MudChip>

    </MudCardActions>
</MudCard>

@code {
    [Parameter]
    public MenuSummaryDTO Menu { get; set; }
}