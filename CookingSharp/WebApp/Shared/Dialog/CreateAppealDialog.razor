@using System.ComponentModel.DataAnnotations
@using WebApp.DTOs
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Solicitud para ser Chef</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-4">Explica por qué te gustaría convertirte en Chef. Tu solicitud será revisada por un administrador.</MudText>
        <EditForm Model="@_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_model.Description"
                          For="@(() => _model.Description)"
                          Label="Tu motivación"
                          Variant="Variant.Outlined"
                          Lines="5" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else
            {
                <span>Enviar Solicitud</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    object? DialogInstance { get; set; }

    private AppealCreateModel _model = new();
    private bool _isSubmitting = false;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_model.Description))
        {
            Snackbar.Add("La descripción no puede estar vacía.", Severity.Warning);
            return;
        }

        _isSubmitting = true;

        var dto = new AppealCreateDTO { Description = _model.Description };

        try
        {
            var response = await Http.PostAsJsonAsync("api/appeals", dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Solicitud enviada con éxito.", Severity.Success);

                try
                {
                    if (DialogInstance != null)
                    {
                        var t = DialogInstance.GetType();
                        var cancel = t.GetMethod("Cancel", System.Type.EmptyTypes);
                        if (cancel != null)
                        {
                            cancel.Invoke(DialogInstance, null);
                        }
                        else
                        {
                            var closeNoArg = t.GetMethod("Close", System.Type.EmptyTypes);
                            if (closeNoArg != null)
                                closeNoArg.Invoke(DialogInstance, null);
                            else
                            {
                                var closeWithArg = t.GetMethod("Close", new[] { typeof(object) });
                                if (closeWithArg != null)
                                    closeWithArg.Invoke(DialogInstance, new object[] { null });
                            }
                        }
                    }
                }
                catch
                {
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Error al enviar la solicitud: {error}", Severity.Error);
                _isSubmitting = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
            _isSubmitting = false;
        }
    }

    void Cancel()
    {
        try
        {
            DialogInstance?.GetType().GetMethod("Cancel", System.Type.EmptyTypes)?.Invoke(DialogInstance, null);
        }
        catch
        {
        }
    }

    public class AppealCreateModel
    {
        [Required(ErrorMessage = "Debes escribir una motivación.")]
        [StringLength(1000, ErrorMessage = "La descripción no puede exceder los 1000 caracteres.")]
        public string Description { get; set; } = "";
    }
}