@page "/"
@using WebApp.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large">

    <div class="text-center mt-8 mb-12">
        <MudText Typo="Typo.h2" GutterBottom="true">Bienvenido a CookingSharp</MudText>
        <MudText Typo="Typo.h5" Color="Color.Dark" Style="opacity: 0.7;">Descubre las creaciones más populares de nuestra comunidad.</MudText>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex justify-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large"/>
        </div>
    }
    else if (homePageData == null || (!homePageData.TopRatedRecipes.Any() && !homePageData.TopRatedMenus.Any()))
    {
        <MudAlert Severity="Severity.Info">Aún no hay suficiente contenido para mostrar. ¡Sé el primero en crear una receta!</MudAlert>
    }
    else
    {
        <!-- Sección de Mejores Recetas -->
        @if(homePageData.TopRatedRecipes.Any())
        {
            <MudText Typo="Typo.h4" GutterBottom="true" Class="mb-4">Recetas Mejor Valoradas</MudText>
            <MudGrid Spacing="4" Class="mb-8">
                @foreach (var recipe in homePageData.TopRatedRecipes)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <RecipeCard Recipe="recipe" />
                    </MudItem>
                }
            </MudGrid>
        }

        <!-- Sección de Mejores Menús -->
        @if(homePageData.TopRatedMenus.Any())
        {
            <MudText Typo="Typo.h4" GutterBottom="true" Class="mb-4">Menús Populares</MudText>
            <MudGrid Spacing="4">
                @foreach (var menu in homePageData.TopRatedMenus)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MenuCard Menu="menu" />
                    </MudItem>
                }
            </MudGrid>
        }
    }

</MudContainer>

@code {
    private HomePageDTO? homePageData;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            homePageData = await Http.GetFromJsonAsync<HomePageDTO>("api/dashboard/home");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}