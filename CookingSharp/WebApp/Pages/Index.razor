@page "/"
@using WebApp.DTOs
@using System.Net.Http.Json
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">

    <div style="text-align: center; margin-bottom: 40px;">
        <MudText Typo="Typo.h2" GutterBottom="true">Bienvenido a CookingSharp</MudText>
        <MudText Typo="Typo.h5" Color="Color.Dark" Style="opacity: 0.7;">Tu recetario colaborativo para gestionar y compartir tus creaciones culinarias.</MudText>
    </div>

    @if (recipes == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var recipe in recipes)
            {
                <MudItem xs="12" sm="6" md="4">
                    <RecipeCard Recipe="recipe" />
                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>

@code {
    private RecipeSummaryDTO[]? recipes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            recipes = await Http.GetFromJsonAsync<RecipeSummaryDTO[]>("api/recipes");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener recetas: {ex.Message}");
        }
    }
}