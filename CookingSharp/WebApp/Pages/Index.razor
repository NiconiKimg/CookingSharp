@page "/"

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">

    <MudPaper Width="100%" Elevation="0" Variant="Variant.Filled" Style="min-height: 45vh;" 
              Class="d-flex flex-column justify-center align-center pa-6 rounded-lg">
        
        <MudIcon Icon="@Icons.Material.Filled.RestaurantMenu" Color="Color.Primary" Size="Size.Large" Class="mb-4" />

        <MudText Typo="Typo.h2" Align="Align.Center" GutterBottom="true">Bienvenido a CookingSharp</MudText>
        <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Dark" Style="opacity: 0.7; max-width: 600px;">
            Tu recetario colaborativo para gestionar y compartir tus creaciones culinarias.
        </MudText>

    </MudPaper>

    <MudDivider Class="my-8" />

    <div class="d-flex flex-column align-center">
        <MudText Typo="Typo.h4" GutterBottom="true">Próximamente...</MudText>
        <MudText Typo="Typo.body1" Color="Color.Dark" Style="opacity: 0.8;">
            Aquí se mostrarán las recetas y menús mejor valorados por la comunidad.
        </MudText>
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-6" />
    </div>

</MudContainer>

@code {
    // El bloque de código está vacío por ahora.
    // La lógica para cargar los menús y recetas mejor valorados se añadirá aquí más adelante.
}