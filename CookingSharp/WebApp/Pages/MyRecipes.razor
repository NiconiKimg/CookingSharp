@page "/my-recipes"
@using WebApp.DTOs
@using WebApp.Shared
@using System.Security.Claims
@using System.Threading
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = "Chef, Admin")]

<MudText Typo="Typo.h3" GutterBottom="true">Mis Recetas</MudText>
<MudText Class="mb-6">Aquí puedes gestionar todas las recetas que has creado.</MudText>

<MudTable T="RecipeResponseDTO"
          ServerData="ServerReload"
          Dense="true" Hover="true" @ref="_table" Striped="true">
    <ToolBarContent>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/recipes/create">
            Crear Nueva Receta
        </MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Nombre</MudTh>
        <MudTh>Estado</MudTh>
        <MudTh Style="text-align:right">Acciones</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Nombre">@context.Name</MudTd>
        <MudTd DataLabel="Estado">
            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@context.Status</MudChip>
        </MudTd>
        <MudTd DataLabel="Acciones" Style="text-align:right">

            @if (context.Status == "Draft")
            {
                <MudButton OnClick="@(() => ChangeRecipeStatus(context, "Published", "publicar"))" Variant="Variant.Filled" Color="Color.Success" Size="Size.Small">Publicar</MudButton>
            }
            @if (context.Status == "Published")
            {
                <MudButton OnClick="@(() => ChangeRecipeStatus(context, "Archived", "archivar"))" Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small">Archivar</MudButton>
            }
            @if (context.Status == "Archived")
            {
                <MudButton OnClick="@(() => ChangeRecipeStatus(context, "Draft", "mover a borrador"))" Variant="Variant.Filled" Color="Color.Info" Size="Size.Small">A Borrador</MudButton>
            }

            <MudTooltip Text="Solo se pueden editar recetas en estado 'Borrador'" Disabled="@(context.Status == "Draft")">
                <MudButton OnClick="@(() => EditRecipe(context.Id))"
                           Variant="Variant.Filled"
                           Color="Color.Default"
                           Size="Size.Small"
                           Class="ml-2"
                           Disabled="@(context.Status != "Draft")">
                    Editar
                </MudButton>
            </MudTooltip>

            <MudIconButton OnClick="@(() => DeleteRecipe(context))" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Class="ml-2" />

        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No has creado ninguna receta todavía.</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Cargando tus recetas...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private MudTable<RecipeResponseDTO> _table = null!;
    private IEnumerable<RecipeResponseDTO> _recipes = new List<RecipeResponseDTO>();
    private int _totalItems;

    private async Task<TableData<RecipeResponseDTO>> ServerReload(TableState state, CancellationToken cancellationToken)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<RecipeResponseDTO>>("api/recipes/my-full-recipes", cancellationToken);
            _recipes = response ?? new List<RecipeResponseDTO>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar tus recetas: {ex.Message}", Severity.Error);
            _recipes = new List<RecipeResponseDTO>();
        }

        _totalItems = _recipes.Count();
        return new TableData<RecipeResponseDTO>() { TotalItems = _totalItems, Items = _recipes };
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Published" => Color.Success,
        "Draft" => Color.Default,
        "Archived" => Color.Warning,
        "Blocked" => Color.Error,
        _ => Color.Info
    };

    private void EditRecipe(int recipeId)
    {
        NavigationManager.NavigateTo($"/recipes/edit/{recipeId}");
    }

    private async Task ChangeRecipeStatus(RecipeResponseDTO recipe, string newStatus, string actionText)
    {
        bool? result = await DialogService.ShowMessageBox(
            $"Confirmar Acción: {actionText.First().ToString().ToUpper() + actionText.Substring(1)}",
            (MarkupString)$"¿Estás seguro de que quieres {actionText} la receta <strong>'{recipe.Name}'</strong>?",
            yesText: "Confirmar",
            cancelText: "Cancelar");

        if (result != true) return;

        var dto = new { Status = newStatus };
        try
        {
            var response = await Http.PatchAsJsonAsync($"api/recipes/{recipe.Id}/status", dto);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"¡Receta actualizada a '{newStatus}' con éxito!", Severity.Success);
                await _table.ReloadServerData();
            }
            else
            {
                Snackbar.Add($"Error al cambiar el estado de la receta.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteRecipe(RecipeResponseDTO recipe)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Confirmar Eliminación",
            (MarkupString)$"¿Estás seguro de que deseas eliminar la receta <strong>'{recipe.Name}'</strong>?",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (result == true)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/recipes/{recipe.Id}");

                if (response.IsSuccessStatusCode)
                {
                    Snackbar.Add("Receta eliminada con éxito.", Severity.Success);
                    await _table.ReloadServerData();
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    Snackbar.Add($"Error al eliminar la receta: {error}", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error de conexión: {ex.Message}", Severity.Error);
            }
        }
    }
}