@page "/recipes/create"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Chef")]

@using MudBlazor

<MudText Typo="Typo.h3" GutterBottom="true">Crear Nueva Receta</MudText>
<MudText Class="mb-4">Aquí irá el formulario para crear una nueva receta.</MudText>

<MudPaper Class="pa-4">
    <MudTextField T="string" Label="Nombre de la Receta" Variant="Variant.Outlined" />
    <MudTextField T="string" Label="Descripción" Lines="5" Variant="Variant.Outlined" Class="mt-3" />
</MudPaper>